msgid "MAP033_TRAINER_3_DEFEAT"
msgstr "Ouaaahh! C'était ouf!"

msgid "MAP033_TRAINER_4"
msgstr "Hé PN! Je viens d'avoir un nouveau Pokémon et je veux voir ce qu'il vaut!"

msgid "MAP033_TRAINER_4_DEFEAT"
