msgid "MAP209_NPC_1"
msgstr "Bienvenue à notre Holiday Resort!\nVOUS êtes la star! Restez un peu... ou forever! Soufflez dans la conque\ns'il vous faut quoi que ce soit."

msgid "MAP209_SIGN_1"
