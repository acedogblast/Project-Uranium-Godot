msgid "MAP033_TRAINER_2"
msgstr "Je devrais aller jouer avec des amis plutôt que de rester planté là."

msgid "MAP033_TRAINER_2_DEFEAT"
msgstr "Je pense que j'essaierais de nouveaux jeux."

msgid "MAP033_TRAINER_3"
